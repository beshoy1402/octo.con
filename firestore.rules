rules_version = '2';

// ══════════════════════════════════════════════════
//  FLAVOR HOUSE — Firestore Security Rules
//
//  HOW TO DEPLOY:
//  1. Firebase Console → Firestore Database → Rules tab
//  2. Replace everything with this → Click "Publish"
// ══════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow any signed-in user (including anonymous) full read/write.
    // This covers customers, admin, kitchen, and waiter panels.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
